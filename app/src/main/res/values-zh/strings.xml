    <string name="settings_title">设置</string>
    <!-- v1.6.0: 设置页拆成两个页签。底图与 Key 归「地图配置」，信号微调从首页搬过来，
         页签名直接复用 section_advanced，避免同一句话在两个资源键里各存一份。 -->
    <string name="settings_tab_map">地图配置</string>
    <string name="settings_signal_desc">决定假位置本身长什么样：精度、海拔、速度与轨迹漂移，以及被检测方能看到什么。开关一改就写入配置。</string>
    <string name="settings_map_service">地图服务</string>
    <string name="settings_map_service_desc">选点页用腾讯地图作底图，地址查询走系统 Geocoder。模块本体（伪造定位）不需要任何地图 Key —— 这一页只影响「地图选点」。</string>
    <string name="settings_provider">底图与 Key</string>
    <string name="settings_provider_desc">本安装包只内置一家底图（腾讯），且不自带任何 Key。请在下方填入你自己的腾讯 Key；申请步骤见下一栏。</string>
    <string name="settings_provider_ready">已就绪：已填写 Key。</string>
    <string name="settings_provider_missing_key">还没有 Key，选点页会是一片空白。</string>
    <string name="provider_tencent">腾讯</string>
    <string name="settings_key_tencent">腾讯 Key</string>
    <string name="settings_key_filled">已填写</string>
    <string name="settings_key_empty">未填写</string>
    <string name="settings_restart_hint">更改 Key 后需要重启本应用才生效：该 SDK 只在启动时读一次 Key。</string>
    <string name="settings_console_title">控制台会问你要的两个值</string>
    <string name="settings_console_desc">腾讯位置服务会把 Key 绑定到这个包名与签名上。差一个字符就会被拒，而报错和「Key 填错了」长得一模一样。请直接复制这两个值，不要手抄。</string>
    <string name="settings_package_label">包名</string>
    <string name="settings_sha1_label">签名 SHA-1</string>
    <string name="settings_sha1_unavailable">读取失败</string>
    <string name="settings_copy">复制</string>
    <string name="settings_copied">已复制</string>
    <string name="settings_howto">如何获取 Key</string>
    <string name="settings_howto_desc">下面是「%1$s」的申请步骤。这些控制台改版频繁，若菜单找不到，主线永远是：应用管理 → 创建应用 → 填包名与 SHA-1。</string>
    <string name="steps_tencent_title">腾讯位置服务 · lbs.qq.com</string>
    <string name="steps_tencent_body">1. 登录腾讯位置服务，进入「控制台 → 应用管理 → 我的应用」。\n2. 创建应用，再在其下「添加 Key」。\n3. 勾选要启用的产品：Android SDK，以及 WebService API（逆地理等 HTTP 接口都走 WebService）。\n4. 填 PackageName 与 SHA1。\n5. 把得到的 Key 复制到上面的腾讯一栏。</string>
    <string name="settings_privacy_note">Key 只保存在本机模块配置里，且仅由对应平台的 SDK 发往该平台自己的服务器。</string>
</resources>
