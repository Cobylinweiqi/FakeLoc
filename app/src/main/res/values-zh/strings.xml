    <!-- 高级参数 -->
    <string name="section_advanced">信号微调</string>
    <string name="adv_accuracy">水平精度</string>
    <string name="adv_accuracy_desc">单位米。数值越小，定位看起来越准。</string>
    <string name="adv_altitude">海拔</string>
    <string name="adv_altitude_desc">相对 WGS-84 椭球面的高度，单位米。</string>
    <string name="adv_speed">地面速度</string>
    <string name="adv_speed_desc">单位米/秒。</string>
    <string name="adv_drift">步行漂移</string>
    <string name="adv_drift_desc">在锚点附近随机游走，让轨迹看起来像真人。</string>
    <string name="adv_drift_radius">漂移半径</string>
    <string name="adv_drift_speed">漂移速度</string>
    <string name="adv_anti_mock">隐藏模拟痕迹</string>
    <string name="adv_anti_mock_desc">抹掉 isFromMockProvider / isMock、mock_location 设置项与 AppOps 检查，让检测方看不到任何异常。</string>
    <string name="adv_strict_sources">锁定定位源</string>
    <string name="adv_strict_sources_desc">拦截 WiFi 扫描、基站信息与原始 GNSS（NMEA、测量值）。切断这些输入后，App 无法自行算出真实位置，也就不会几分钟后又跳回去。</string>
    <string name="adv_map_sdk">接管地图 SDK</string>
    <string name="adv_map_sdk_desc">直接钩住高德 / 百度 / 腾讯三家的定位 SDK，包括 App 自己单独加载的实例。定位结果不走系统、只从地图 SDK 读的 App 需要这一项。</string>
    <string name="adv_sync_address">同步伪造地址</string>
    <string name="adv_sync_address_desc">把地图 SDK 的省 / 市 / 区 / 地址接口改成锚点对应的值（由「地图选点」逆地理得到）。显示定位 SDK 城市名的 App 依赖它 —— 地址保持真实或留空时，它们会一直显示你的真实城市。若某个 App 因此出问题就关掉。</string>
    <string name="addr_unresolved">城市未解析 · 打开「地图选点」保存一次即可</string>

